msgstr "Arrêt après l'itération en cours..."

msgid "Starting the campaign..."
msgstr "Démarrage de la campagne..."

msgid "Warmup iteration %1 of %2 - scenario \"%3\" (%4 regime)"
msgstr "Itération de préchauffage %1 sur %2 - scénario « %3 » (régime %4)"

msgid "Iteration %1 of %2 - scenario \"%3\" (%4 regime)"
msgstr "Itération %1 sur %2 - scénario « %3 » (régime %4)"

msgid "Step %1 of %2 - %3 failed so far."
msgstr "Étape %1 sur %2 - %3 en échec à ce stade."

msgid "Benchmark: campaign stopped on request after %1 of %2 iterations. The iterations already measured are kept."
msgstr "Benchmark : campagne arrêtée à votre demande après %1 itérations sur %2. Les itérations déjà mesurées sont conservées."

msgid "Benchmark: campaign finished, %1 iterations failed and are recorded with their cause in bench_raw.csv."
msgstr "Benchmark : campagne terminée, %1 itérations ont échoué et sont consignées avec leur cause dans bench_raw.csv."

msgid "Benchmark: campaign finished."
msgstr "Benchmark : campagne terminée."

msgid "Run: %1"
msgstr "Identifiant de campagne : %1"

msgid "Arm: %1"
msgstr "Bras : %1"

msgid "Iterations measured: %1 of %2 (warmup %3, excluded from the aggregates below but kept in bench_raw.csv)"
msgstr "Itérations mesurées : %1 sur %2 (préchauffage %3, exclues des agrégats ci-dessous mais conservées dans bench_raw.csv)"

msgid "Failed iterations: %1"
msgstr "Itérations en échec : %1"

msgid "Message bus: %1"
msgstr "Bus de messages : %1"

msgid "A residual benchmark table was dropped before the campaign, on your confirmation."
msgstr "Une table de benchmark résiduelle a été supprimée avant la campagne, après votre confirmation."

msgid "The teardown step failed: \"%1\". The technical table may still be there; the next campaign will offer to drop it."
msgstr "L'étape de nettoyage a échoué : « %1 ». La table technique est peut-être encore présente ; la prochaine campagne proposera de la supprimer."

msgid "This tab went to the background during the campaign: the browser throttles its timers, so the figures of that window are not comparable."
msgstr "Cet onglet est passé en arrière-plan pendant la campagne : le navigateur ralentit alors ses minuteurs, les chiffres de cette période ne sont pas comparables."

msgid "No aggregate row: every measured iteration was a warmup or a failure. The raw file still holds every sample."
msgstr "Aucune ligne d'agrégat : toutes les itérations mesurées étaient du préchauffage ou des échecs. Le fichier brut contient malgré tout chaque mesure."

